---
import BaseLayout from "@/app/layouts/BaseLayout.astro";
import { PostPage } from "@/_pages/post";
import { entrySlug, getPosts, hasPostIn } from "@/shared/api/content";
import type { Post } from "@/shared/api/content";
import { counterpartPath, dictionaryFor, localizedPath, pageTitle } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n";
import { ArticleTopBar } from "@/shared/ui";

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getPosts("en");

	return posts.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}

interface Props {
	entry: Post;
}

const locale: Locale = "en";
const { entry } = Astro.props;
const slug = entrySlug(entry.id);
const path = localizedPath(locale, "post", slug);
const strings = dictionaryFor(locale);
const indonesianPath = (await hasPostIn("id", slug)) ? counterpartPath(path) : undefined;
const alternates = { en: path, id: indonesianPath };
---

<BaseLayout
	locale={locale}
	title={pageTitle(locale, entry.data.title)}
	description={entry.data.summary}
	path={path}
	pageName={entry.data.title}
	alternates={alternates}
	markdownPath={localizedPath(locale, "postMarkdown", slug)}
	ogType="article"
>
	<ArticleTopBar
		slot="header"
		backHref={localizedPath(locale, "writing")}
		backLabel={strings.article.backWriting}
		locale={locale}
		alternates={alternates}
		section="writing"
	/>
	<PostPage locale={locale} entry={entry} />
</BaseLayout>
