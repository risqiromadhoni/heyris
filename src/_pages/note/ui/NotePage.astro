---
import { render } from "astro:content";
import { CopyPage } from "@/features/copy-page";
import { TableOfContents, tocItems } from "@/features/table-of-contents";
import { entrySlug, getNoteListing, readingTime } from "@/shared/api/content";
import type { Note } from "@/shared/api/content";
import { localizedPath } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n";
import { Byline, FeedbackLine, Prose } from "@/shared/ui";
import RelatedNotes from "./RelatedNotes.astro";
import TagList from "./TagList.astro";
import TldrBox from "./TldrBox.astro";

interface Props {
	/** Locale of the page's copy and links. */
	locale: Locale;
	entry: Note;
}

const { locale, entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = tocItems(headings);
const markdownUrl = new URL(localizedPath(locale, "noteMarkdown", entrySlug(entry.id)), Astro.site).href;

// Notes are newest first, so the older neighbour comes after this note and the newer one before it.
const notes = await getNoteListing(locale);
const index = notes.findIndex((note) => note.id === entry.id);
const previous = index === -1 ? undefined : notes[index + 1];
const next = index > 0 ? notes[index - 1] : undefined;
---

<article class="mx-auto w-full max-w-[1440px] px-5 pt-12 pb-24 sm:px-[49px]">
	<header class="mx-auto flex w-full max-w-[600px] flex-col gap-3 pt-6 pb-[14.8px]">
		<h1 class="type-article">{entry.data.title}</h1>
		<Byline locale={locale} date={entry.data.date} updated={entry.data.updated} precision="day" minutes={readingTime(entry)}>
			<div class="flex items-stretch gap-2">
				<CopyPage locale={locale} markdownUrl={markdownUrl} />
				{toc.length > 0 && <TableOfContents locale={locale} items={toc} />}
			</div>
		</Byline>
		{entry.data.tags.length > 0 && <TagList tags={entry.data.tags} />}
	</header>
	{entry.data.tldr !== undefined && <TldrBox locale={locale} text={entry.data.tldr} />}
	<Prose>
		<Content />
	</Prose>
	<div class="mx-auto w-full max-w-[600px]">
		<FeedbackLine locale={locale} title={entry.data.title} />
	</div>
	<RelatedNotes locale={locale} previous={previous} next={next} />
</article>
