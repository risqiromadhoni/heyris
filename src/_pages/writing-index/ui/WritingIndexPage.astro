---
import { FilterSearch } from "@/features/filter-entries";
import { getNewestPost, getPostListing, groupPostsByYear } from "@/shared/api/content";
import { dictionaryFor, type Locale } from "@/shared/i18n";
import { RailSection } from "@/shared/ui";
import PostRow from "./PostRow.astro";
import TopicTabs from "./TopicTabs.astro";

interface Props {
	/** Locale of the copy and links on the page. */
	locale: Locale;
}

const { locale } = Astro.props;
const strings = dictionaryFor(locale);
const posts = await getPostListing(locale);
const newest = await getNewestPost(locale);
const years = groupPostsByYear(posts);
---

<div
	data-filter-root
	data-kind="writing"
	data-locale={locale}
	class="mx-auto flex max-w-[1440px] flex-col gap-16 px-5 sm:px-[49px]"
>
	<div class="flex flex-col gap-8 lg:grid lg:grid-cols-[300px_minmax(0,760px)] lg:gap-0">
		<div class="flex flex-col gap-2.5">
			<h1 class="type-display">{strings.writing.title}</h1>
			<p class="type-ui">{strings.writing.count(posts.length)}</p>
		</div>
		<div class="flex min-w-0 flex-col gap-8 pt-2">
			<p class="type-body">{strings.writing.intro}</p>
			<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
				<TopicTabs locale={locale} posts={posts} />
				<FilterSearch locale={locale} />
			</div>
		</div>
	</div>

	{
		years.map((group) => (
			<RailSection
				heading={String(group.year)}
				count={strings.writing.count(group.posts.length)}
				headingId={`writing-year-${group.year}`}
				data-filter-group=""
			>
				<ul>
					{group.posts.map((post) => (
						<PostRow post={post} locale={locale} newest={post.id === newest?.id} />
					))}
				</ul>
			</RailSection>
		))
	}
</div>
