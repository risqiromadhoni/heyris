---
import { SITE } from "@/shared/config";
import { dictionaryFor, type Locale } from "@/shared/i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const strings = dictionaryFor(locale);
const href = `mailto:${SITE.email}?subject=${encodeURIComponent(strings.home.contactSubject)}&body=${encodeURIComponent(strings.home.contactBody)}`;
---

<a
	href={href}
	aria-label={strings.home.contactLabel}
	data-contact-trigger
	class="contact inline-flex h-[34px] shrink-0 items-center justify-center gap-1.5 rounded-full border border-lr-line bg-lr-surface px-[9px] font-sans text-[13px] font-medium text-lr-heading focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lr-text sm:justify-start sm:pr-3.5 sm:pl-3"
>
	<span class="icon-stack grid size-4 shrink-0" aria-hidden="true">
		<span class="icon icon-mail i-lucide-mail col-start-1 row-start-1 size-4"></span>
		<span class="icon icon-arrow i-lucide-arrow-up-right col-start-1 row-start-1 size-4"></span>
	</span>
	<span class="hidden sm:inline">{strings.home.contact}</span>
</a>

<style>
	.icon {
		transition:
			opacity 250ms ease-in-out,
			filter 250ms ease-in-out,
			transform 250ms ease-in-out;
	}

	.icon-arrow {
		opacity: 0;
		filter: blur(2px);
		transform: scale(0.25);
	}

	.contact:is(:hover, :focus-visible) .icon-mail {
		opacity: 0;
		filter: blur(2px);
		transform: scale(0.25);
	}

	.contact:is(:hover, :focus-visible) .icon-arrow {
		opacity: 1;
		filter: none;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.icon {
			transition: none;
		}
	}
</style>
