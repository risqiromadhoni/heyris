---
import { localizedPath } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n";
import { LanguageToggle } from "@/shared/ui";
import BioToggle from "./BioToggle.astro";
import ContactLinks from "./ContactLinks.astro";
import HomeTitle from "./HomeTitle.astro";
import IllustrationPanel from "./IllustrationPanel.astro";
import NoteList from "./NoteList.astro";
import PostList from "./PostList.astro";

interface Props {
	/** Locale of the copy and links on the page. */
	locale: Locale;
}

const { locale } = Astro.props;
const alternates = { id: localizedPath("id", "home"), en: localizedPath("en", "home") };
---

<div
	class="mx-auto max-w-[1440px] px-5 py-5 sm:px-[49px] sm:py-[49px] lg:grid lg:grid-cols-[minmax(0,600fr)_minmax(0,469fr)] lg:gap-x-[max(3rem,calc(100%_-_1069px))]"
>
	<div class="mx-auto flex w-full max-w-[600px] min-w-0 flex-col lg:mx-0 lg:max-w-none">
		<div class="flex flex-col gap-3">
			<HomeTitle />
			<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
				<ContactLinks locale={locale} />
				<LanguageToggle locale={locale} alternates={alternates} />
			</div>
		</div>
		<BioToggle locale={locale} />
		<div class="flex flex-col gap-14">
			<NoteList locale={locale} />
			<PostList locale={locale} />
		</div>
	</div>
	<IllustrationPanel locale={locale} />
</div>
