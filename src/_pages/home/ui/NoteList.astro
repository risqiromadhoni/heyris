---
import { entryLocale, entrySlug, foreignLocale, getNoteListing } from "@/shared/api/content";
import { dictionaryFor, localizedPath } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const strings = dictionaryFor(locale);
const notes = (await getNoteListing(locale)).slice(0, 10);
---

<section aria-labelledby="home-notes" class="flex flex-col gap-[19.2px]">
	<div class="flex items-center justify-between">
		<h2 id="home-notes" class="type-h2">{strings.home.notes}</h2>
		<a
			href={localizedPath(locale, "notes")}
			class="inline-flex items-center gap-1 font-sans text-[14px] font-medium text-lr-nav hover:text-lr-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lr-text"
			>{strings.home.seeAll}<span aria-hidden="true" class="i-lucide-arrow-right size-4"></span></a
		>
	</div>
	<ul
		class="flex flex-col gap-[3.2px] sm:grid sm:grid-flow-col sm:grid-cols-2 sm:gap-x-[21.3px]"
		style={`grid-template-rows: repeat(${Math.ceil(notes.length / 2)}, auto);`}
	>
		{
			notes.map((note) => (
				<li class="flex gap-[12.75px] pl-[3px]">
					<span aria-hidden="true" class="mt-[11.8px] size-[5.5px] shrink-0 bg-lr-bullet"></span>
					<a
						href={localizedPath(entryLocale(note.id), "note", entrySlug(note.id))}
						hreflang={foreignLocale(note, locale)}
						class="group type-link py-[2px] leading-[1.3] hover:text-lr-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lr-text"
					>
						<span
							class="underline decoration-lr-underline decoration-1 underline-offset-[4px] group-hover:decoration-current"
							lang={foreignLocale(note, locale)}
						>
							{note.data.label ?? note.data.title}
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>
