---
import { Artwork, ShaderCanvas } from "@/shared/ui";
import type { Locale } from "@/shared/i18n";
import NightOverlay from "./NightOverlay.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<div class="mx-auto mt-14 w-full max-w-[600px] lg:mx-0 lg:mt-0 lg:max-w-none lg:pt-[49px]">
	<div
		class="relative isolate aspect-[4/3] overflow-hidden rounded-[10px] outline outline-1 -outline-offset-1 outline-lr-line lg:aspect-auto lg:h-[min(910px,calc(100svh_-_147px))]"
	>
		<Artwork
			class="absolute inset-0 size-full object-cover object-top lg:object-center"
			loading="eager"
			fetchpriority="high"
		/>
		<ShaderCanvas scene="panel" />
		<NightOverlay />
		<ThemeToggle locale={locale} />
	</div>
</div>
