---
import { FilterSearch } from "@/features/filter-entries";
import { getNoteListing, groupNotesByMonth, pinnedNotes } from "@/shared/api/content";
import { dictionaryFor, formatMonthYear, type Locale } from "@/shared/i18n";
import { RailSection } from "@/shared/ui";
import NoteRow from "./NoteRow.astro";
import PinnedNoteCard from "./PinnedNoteCard.astro";
import TopicPills from "./TopicPills.astro";

interface Props {
	/** Locale of the copy and links on the page. */
	locale: Locale;
}

const { locale } = Astro.props;
const strings = dictionaryFor(locale);
const notes = await getNoteListing(locale);
const pinned = pinnedNotes(notes);
const months = groupNotesByMonth(notes);
---

<div
	data-filter-root
	data-kind="notes"
	data-locale={locale}
	class="mx-auto flex max-w-[1440px] flex-col gap-16 px-5 sm:px-[49px]"
>
	<div class="flex flex-col gap-8 lg:grid lg:grid-cols-[300px_minmax(0,760px)] lg:gap-0">
		<div class="flex flex-col gap-2.5">
			<h1 class="type-display">{strings.notes.title}</h1>
			<p class="type-ui">{strings.notes.count(notes.length)}</p>
		</div>
		<div class="flex min-w-0 flex-col gap-8 pt-2">
			<p class="type-body">{strings.notes.intro}</p>
			<div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-4">
				<TopicPills locale={locale} notes={notes} />
				<FilterSearch locale={locale} />
			</div>
		</div>
	</div>

	{
		pinned.length > 0 && (
			<RailSection
				heading={strings.notes.pinned}
				count={strings.notes.count(pinned.length)}
				headingId="notes-pinned"
				rule={false}
				data-filter-group=""
			>
				<ul class="grid gap-4 md:grid-cols-2">
					{pinned.map((note) => (
						<PinnedNoteCard note={note} locale={locale} />
					))}
				</ul>
			</RailSection>
		)
	}

	{
		months.map((group) => (
			<RailSection
				heading={formatMonthYear(new Date(Date.UTC(group.year, group.month - 1, 1)), locale)}
				count={strings.notes.count(group.notes.length)}
				headingId={`notes-month-${group.year}-${group.month}`}
				data-filter-group=""
			>
				<ul>
					{group.notes.map((note) => (
						<NoteRow note={note} locale={locale} />
					))}
				</ul>
			</RailSection>
		))
	}
</div>
