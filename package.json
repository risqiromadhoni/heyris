{
  "name": "heyris",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "vp check && knip",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "knip": "knip",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "void:deploy": "void deploy --platform cloudflare",
    "unlighthouse": "unlighthouse",
    "unlighthouse:ci": "unlighthouse-ci",
    "prepare": "vp config && void prepare"
  },
  "dependencies": {
    "astro": "^7.4.11"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/markdown-satteri": "0.4.9",
    "@axe-core/playwright": "^4.14.0",
    "@oxlint/plugins": "1.91.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@unocss/astro": "^66.12.0",
    "@unocss/extractor-mdc": "^66.12.0",
    "knip": "^6.45.1",
    "unlighthouse": "^0.19.1",
    "unocss": "^66.12.0",
    "vite-plus": "catalog:",
    "void": "^1.7.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
