{
  "name": "heyris",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "vp check && astro check && knip",
    "check:fix": "vp check --fix && astro check && knip --fix",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "knip": "knip",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "void:deploy": "void deploy --platform cloudflare",
    "unlighthouse": "unlighthouse",
    "unlighthouse:ci": "unlighthouse-ci",
    "prepare": "vp config && void prepare"
  },
  "dependencies": {
    "astro": "^7.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/markdown-satteri": "0.4.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/lucide": "^1.2.153",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.102",
    "@oxlint/plugins": "1.91.0",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "1.3.10",
    "@unocss/astro": "^66.12.0",
    "@unocss/extractor-mdc": "^66.12.0",
    "knip": "^6.45.1",
    "opentype.js": "1.3.4",
    "typescript": "^6.0.3",
    "unlighthouse": "^0.19.1",
    "unocss": "^66.12.0",
    "vite-plus": "catalog:",
    "void": "^1.7.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
