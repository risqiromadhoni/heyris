                  "gap": 23.2,
                  "children": [
                    {
                      "type": "text",
                      "id": "oLZW1",
                      "name": "Paragraph 1",
                      "fill": "$lr-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Saya software engineer dan penulis. Saya membangun situs web yang ringan, tanpa pelacak, dan sesuai WCAG 2.2 AA. Kodenya TypeScript dengan Effect, jalan di Cloudflare Workers. Situs yang sedang Anda baca ini contohnya.",
                      "lineHeight": 1.6,
                      "fontFamily": "$lr-serif",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "ED64n",
                      "name": "Paragraph 2",
                      "fill": "$lr-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Saya menulis catatan teknis dalam bahasa Indonesia, dan setiap tulisan punya versi Markdown untuk dibaca manusia maupun AI. Kalau Anda punya proyek, pertanyaan, atau sekadar ingin menyapa, kirim surel ke halo@heyris.me.",
                      "lineHeight": 1.6,
                      "fontFamily": "$lr-serif",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
